  m_Script: {fileID: 11500000, guid: 9528ef4597f6b2d43b96195a7efd2ab4, type: 3}
  m_Name: Celular_SegundoPlano_Data
  m_EditorClassIdentifier: Assembly-CSharp::Unbreathe.Dialogue.DialogueData
  sequenceTitle: "Tel\xE9fono de Caro"
  lines:
  - speakerName: '[Buscando frecuencia de resonancia local...]'
    message: "(La pantalla agrietada ilumina d\xE9bilmente la penumbra. En la bandeja
      de salida hay un mensaje de texto atascado...)"
    voiceAudio: {fileID: 0}
  - speakerName: 'Mensaje no enviado -> Para: Caro'
    message: "\"\xBFSigues ah\xED? Llevo horas caminando. Puse nuestra playlist de
      madrugada para no perder la cabeza, pero hasta la m\xFAsica suena ahogada,
      como si estuviera bajo el agua.\""
    voiceAudio: {fileID: 0}
  - speakerName: 'Mensaje no enviado -> Para: Caro'
    message: "\"Siento que las calles est\xE1n llenas, juro que respiro a otras personas
      cerca, pero no veo a nadie.\""
    voiceAudio: {fileID: 0}
  - speakerName: Sistema ECHO
    message: "[Frecuencia detectada en fase Abismo. La ciudad jam\xE1s estuvo vac\xEDa.
      Sintoniza y activa el nodo ECHO.]"
    voiceAudio: {fileID: 0}
